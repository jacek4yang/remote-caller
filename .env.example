# Local-development template. The application does not load this file itself.
BIND_ADDR=127.0.0.1:8080
SERVE_STATIC=true
STATIC_DIR=web
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_USERS_JSON='[{"username":"caller-one","displayName":"Caller One","passwordHash":"$argon2id$REPLACE_WITH_FIRST_HASH","role":"user"},{"username":"caller-two","displayName":"Caller Two","passwordHash":"$argon2id$REPLACE_WITH_SECOND_HASH","role":"user"}]'

SESSION_TTL_SECS=604800
AUTH_MAX_CONCURRENT_HASHES=2
MAX_WS_CONNECTIONS=16
MAX_WS_PER_USER=3
MAX_ROOMS=8
WS_TICKET_TTL_SECS=30
MAX_PENDING_WS_TICKETS=32

# Set true only on Linux and configure all TURN values below.
EMBEDDED_TURN=false
# TURN_SECRET=REPLACE_WITH_A_DIFFERENT_32_BYTE_RANDOM_SECRET
TURN_REALM=call.example.com
# TURN_PUBLIC_IP=REPLACE_WITH_SERVER_PUBLIC_IPV4
TURN_BIND_IP=0.0.0.0
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49175
TURN_MAX_SESSIONS=64
# TURN_TLS_CERT=/etc/remote-caller/tls/fullchain.pem
# TURN_TLS_KEY=/etc/remote-caller/tls/privkey.pem
STUN_URL=stun:call.example.com:3478
RUST_LOG=remote_caller=info,tower_http=info
