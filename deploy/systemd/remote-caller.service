[Unit]
Description=Remote Caller Rust signaling and TURN service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=remote-caller
Group=remote-caller
WorkingDirectory=/opt/remote-caller
EnvironmentFile=/etc/remote-caller/remote-caller.env
ExecStart=/opt/remote-caller/bin/remote-caller
Restart=on-failure
RestartSec=2s
TimeoutStopSec=35s
KillSignal=SIGTERM
LimitNOFILE=4096
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
SystemCallArchitectures=native
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
